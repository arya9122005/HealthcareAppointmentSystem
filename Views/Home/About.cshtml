@{ ViewData["Title"] = "About"; }
<div class="container py-5" style="max-width: 900px;">
    <h1 class="page-title mb-3">About Peony Health</h1>
    <p class="lead-soft">Peony Health is a healthcare appointment and patient management system built as a C# and ASP.NET Core MVC course project.</p>

    <div class="row g-4 mt-1">
        <div class="col-md-4">
            <div class="card-soft pad h-100">
                <span class="stat-icon rose mb-3"><i class="bi bi-person-heart"></i></span>
                <h2 class="h5">Patients</h2>
                <p class="muted mb-0">Register, find doctors, book and cancel appointments, and read consultation notes.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card-soft pad h-100">
                <span class="stat-icon lilac mb-3"><i class="bi bi-heart-pulse"></i></span>
                <h2 class="h5">Doctors</h2>
                <p class="muted mb-0">Set weekly availability, confirm or cancel visits, and record consultation notes.</p>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card-soft pad h-100">
                <span class="stat-icon amber mb-3"><i class="bi bi-shield-check"></i></span>
                <h2 class="h5">Administrators</h2>
                <p class="muted mb-0">Manage doctors, specializations, appointments, users and roles from one dashboard.</p>
            </div>
        </div>
    </div>

    <div class="card-soft pad mt-4">
        <h2 class="h5">Built with</h2>
        <p class="mb-0 muted">C# · ASP.NET Core MVC (.NET 8) · Entity Framework Core · SQL Server · ASP.NET Core Identity · Razor · Bootstrap 5</p>
    </div>
</div>
