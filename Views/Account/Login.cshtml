@model LoginViewModel
@{ ViewData["Title"] = "Log in"; }
<div class="auth-wrap">
    <div class="card-soft auth-card">
        <h1 class="h2 mb-1">Welcome back</h1>
        <p class="muted mb-4">Log in to manage your appointments.</p>

        <partial name="_Alerts" />
        <form asp-action="Login" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
            <input type="hidden" asp-for="ReturnUrl" />
            <div class="mb-3">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" autocomplete="username" />
                <span asp-validation-for="Email"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password"></span>
            </div>
            <div class="form-check mb-4">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>
            <button type="submit" class="btn btn-primary w-100">Log in</button>
        </form>
        <p class="text-center mt-3 mb-4">New here? <a asp-action="Register">Create an account</a></p>

        <div class="demo-box">
            <div class="fw-bold mb-1">Demo accounts</div>
            <div>Admin: <code>admin@@healthcare.com</code> / <code>Admin@@123</code></div>
            <div>Doctor: <code>ananya.sharma@@healthcare.com</code> / <code>Doctor@@123</code></div>
            <div>Patient: <code>priya.das@@example.com</code> / <code>Patient@@123</code></div>
        </div>
    </div>
</div>
