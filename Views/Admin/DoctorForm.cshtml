@model DoctorFormViewModel
@{
    bool isEdit = Model.Id != 0;
    ViewData["Title"] = isEdit ? "Edit doctor" : "Add doctor";
}
<a asp-action="Doctors" class="small"><i class="bi bi-arrow-left"></i> Doctors</a>
<div class="page-header mt-2"><div><h1 class="page-title">@ViewData["Title"]</h1></div></div>

<div class="card-soft pad">
    <form asp-action="@(isEdit ? "EditDoctor" : "CreateDoctor")" method="post" novalidate>
        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        <input type="hidden" asp-for="Id" />
        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="FullName" class="form-label"></label>
                <input asp-for="FullName" class="form-control" placeholder="Dr. First Last" />
                <span asp-validation-for="FullName"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Email" class="form-label"></label>
                <input asp-for="Email" class="form-control" readonly="@isEdit" />
                <span asp-validation-for="Email"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Phone" class="form-label"></label>
                <input asp-for="Phone" class="form-control" />
                <span asp-validation-for="Phone"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Password" class="form-label">@(isEdit ? "New password (leave blank to keep current)" : "Initial password")</label>
                <input asp-for="Password" class="form-control" autocomplete="new-password" />
                <span asp-validation-for="Password"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="SpecializationId" class="form-label"></label>
                <select asp-for="SpecializationId" class="form-select" asp-items="@(new SelectList(Model.Specializations, "Id", "Name"))">
                    <option value="">Select specialization</option>
                </select>
                <span asp-validation-for="SpecializationId"></span>
            </div>
            <div class="col-md-6">
                <label asp-for="Qualification" class="form-label"></label>
                <input asp-for="Qualification" class="form-control" />
                <span asp-validation-for="Qualification"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="ExperienceYears" class="form-label"></label>
                <input asp-for="ExperienceYears" type="number" min="0" max="60" class="form-control" />
                <span asp-validation-for="ExperienceYears"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="ConsultationFee" class="form-label"></label>
                <input asp-for="ConsultationFee" type="number" min="0" step="1" class="form-control" />
                <span asp-validation-for="ConsultationFee"></span>
            </div>
            <div class="col-12">
                <label asp-for="Bio" class="form-label"></label>
                <textarea asp-for="Bio" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Bio"></span>
            </div>
        </div>
        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">@(isEdit ? "Save changes" : "Add doctor")</button>
            <a class="btn btn-soft" asp-action="Doctors">Cancel</a>
        </div>
    </form>
</div>
