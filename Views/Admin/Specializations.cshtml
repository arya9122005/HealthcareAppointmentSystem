@model List<Specialization>
@{ ViewData["Title"] = "Specializations"; }
<div class="page-header"><div><h1 class="page-title">Specializations</h1><p class="page-sub">The categories patients use to find doctors.</p></div></div>

<div class="card-soft pad mb-4">
    <h2 class="h5 mb-3">Add a specialization</h2>
    <form asp-action="SaveSpecialization" method="post" class="row g-3 align-items-end">
        <input type="hidden" name="id" value="0" />
        <div class="col-md-4"><label class="form-label" for="newName">Name</label><input id="newName" name="name" class="form-control" maxlength="80" required /></div>
        <div class="col-md-6"><label class="form-label" for="newDesc">Description</label><input id="newDesc" name="description" class="form-control" maxlength="300" /></div>
        <div class="col-md-2 d-grid"><button class="btn btn-primary" type="submit">Add</button></div>
    </form>
</div>

<div class="card-soft">
    <div class="card-head"><h2>All specializations</h2></div>
    <div class="table-responsive">
        <table class="table table-soft">
            <thead><tr><th style="width:24%">Name</th><th>Description</th><th>Doctors</th><th></th></tr></thead>
            <tbody>
            @foreach (var s in Model)
            {
                <tr>
                    <td colspan="3">
                        <form asp-action="SaveSpecialization" method="post" class="row g-2 align-items-center">
                            <input type="hidden" name="id" value="@s.Id" />
                            <div class="col-md-4"><input name="name" value="@s.Name" class="form-control form-control-sm" maxlength="80" required aria-label="Name" /></div>
                            <div class="col-md-6"><input name="description" value="@s.Description" class="form-control form-control-sm" maxlength="300" aria-label="Description" /></div>
                            <div class="col-md-2 d-flex align-items-center gap-2"><span class="pill">@s.Doctors.Count</span><button class="btn btn-soft btn-sm" type="submit">Save</button></div>
                        </form>
                    </td>
                    <td class="text-end">
                        <form asp-action="DeleteSpecialization" asp-route-id="@s.Id" method="post" onsubmit="return confirm('Delete this specialization?');">
                            <button class="btn btn-outline-danger btn-sm" type="submit" disabled="@(s.Doctors.Any())" title="@(s.Doctors.Any() ? "In use by doctors" : "Delete")">Delete</button>
                        </form>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</div>
