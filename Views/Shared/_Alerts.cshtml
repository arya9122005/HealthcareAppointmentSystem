@if (TempData["Success"] != null)
{
    <div class="alert alert-success d-flex align-items-center gap-2" role="status" data-autohide>
        <i class="bi bi-check-circle-fill"></i><span>@TempData["Success"]</span>
    </div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger d-flex align-items-center gap-2" role="alert">
        <i class="bi bi-exclamation-circle-fill"></i><span>@TempData["Error"]</span>
    </div>
}
